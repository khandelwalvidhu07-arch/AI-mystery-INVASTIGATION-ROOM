# ─────────────────────────────────────────────
# SERVER ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
PORT=5000

# MongoDB connection string (Atlas or local)
# If omitted, the server auto-starts an in-memory MongoDB (great for zero-config testing)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-mystery-room?retryWrites=true&w=majority

# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
# If omitted, the server uses a built-in fallback mystery (no AI key required to run!)
GEMINI_API_KEY=your_gemini_api_key_here

# URL of the frontend client (used for CORS)
# LOCAL DEV:
CLIENT_URL=http://localhost:5173
# OTHER DEVICE ON LAN: set to http://<your-machine-LAN-IP>:5173
# PRODUCTION: set to your deployed frontend URL (e.g. https://your-app.vercel.app)
