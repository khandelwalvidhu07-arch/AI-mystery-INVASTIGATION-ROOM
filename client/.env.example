# ─────────────────────────────────────────────
# CLIENT ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
# LOCAL DEVELOPMENT (same machine):
#   VITE_API_URL=http://localhost:5000/api
#
# LAN / OTHER DEVICE ON SAME NETWORK:
#   Replace with your machine's LAN IP (e.g. from `ipconfig` on Windows / `ifconfig` on Mac/Linux)
#   VITE_API_URL=http://192.168.x.x:5000/api
#
# PRODUCTION (deployed backend on Render / Railway / etc.):
#   VITE_API_URL=https://your-backend.onrender.com/api
#
VITE_API_URL=http://localhost:5000/api
